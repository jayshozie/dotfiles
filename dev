#!/usr/bin/env bash

export DEV_ENV=$(cd "$(dirname "$0")" && pwd)
source "${DEV_ENV}/lib/log" && export -f log && export -f logp
source "${DEV_ENV}/lib/ansi-escapes"
source "${DEV_ENV}/lib/progress_bar" && export -f progress_bar

SRCS="${HOME}/src/upstream"

usage() {
    printf "${FG_L_MAGENTA}dev - Jayshozie's Autobuilder${COLOR_RESET}
Usage: ${FG_L_MAGENTA}dev ${FG_L_YELLOW}[-v|--verbose]
           [-h|[-]-help]
           [-d|[-]-dry-run]
           [-A|[-]-all]
           [-n|[-]-nvim|[-]-neovim]
           [-t|[-]-tmux]
           [-a|[-]-alacritty]
           [--license] ${COLOR_RESET}

Options:
  ${FG_L_YELLOW}-v  [-]-verbose             ${FG_L_BLUE}Runs commands loudly
  ${FG_L_YELLOW}-h  [-]-help                ${FG_L_BLUE}Shows this message
  ${FG_L_YELLOW}-d  [-]-dry-run             ${FG_L_BLUE}Doesn't run any commands, show what would be run instead
  ${FG_L_YELLOW}-A  [-]-all                 ${FG_L_BLUE}Build all programs
  ${FG_L_YELLOW}-n  [[-]-neovim|[-]-nvim]   ${FG_L_BLUE}Build Neovim
  ${FG_L_YELLOW}-t  [-]-tmux                ${FG_L_BLUE}Build tmux
  ${FG_L_YELLOW}-a  [-]-alacritty           ${FG_L_BLUE}Build Alacritty
  ${FG_L_YELLOW}--license                   ${FG_L_BLUE}Shows the program's license${COLOR_RESET}
"
}

