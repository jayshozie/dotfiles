# Global Audit Ignores
# Patterns apply to files relative to the module destination.

# --- Tooling & Meta ---
.git/*
node_modules/*
__pycache__/*

# --- App Specific Artifacts ---
tmp/*
history/*
chats/*
*.json
coredump.conf
homed.conf
journald.conf
journal-remote.conf
journal-upload.conf
networkd.conf
oomd.conf
pstore.conf
resolved.conf
sleep.conf
system.conf
input.conf
network.conf
system/grub-btrfsd.service
system/grub-btrfsd.service.d/override.conf
timesyncd.conf
user.conf
zram-generator.conf
installation_id
plugins/tmux-continuum*
plugins/tmux-resurrect*
plugins/tmux-sensible*
plugins/tokyo-night-tmux*
plugins/tpm*
resurrect/*
lazy-lock.json
nvidia*
*.pacnew*
