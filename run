#!/usr/bin/env bash

# Usage: ./run [-dry|--dry-run|-d]

export DEV_ENV=$(cd "$(dirname "$0")" && pwd)
export DRY_RUN='0'
export RUN_AUDIT='0'
source "${DEV_ENV}/lib/log"
source "${DEV_ENV}/lib/term-colors"
export -f log

# --- Safety Check: Prevent suicide ---
# We explicitly forbid the DEST from being root or HOME to prevent accidents.
# Yep, I nuked my home directory before doing this. Thank God for btrfs, I
# almost had a heart attack.
is_safe_path() {
    local path="$1"
    if [[ "$path" == "$HOME" || "$path" == "/" ]]; then
        return 1 # False (Unsafe)
    fi
    return 0 # True (Safe)
}

is_ignored() {
    local rel_file="$1"
    local ignore_file="${DEV_ENV}/.auditignore"
    [[ ! -f "$ignore_file" ]] && return 1

    while read -r pattern || [[ -n "$pattern" ]]; do
        [[ -z "$pattern" || "$pattern" == "#"* ]] && continue
        if [[ "$rel_file" == $pattern ]]; then
            return 0
        fi
    done < "$ignore_file"
    return 1
}

audit_module() {
    local m="$1"
    [[ ! -d "$m" ]] && return
    [[ ! -f "$m/.dest" ]] && return
    [[ ! -d "$m/payload" ]] && return

    local module_name=$(basename "$m")
    local DEST=$(envsubst < "$m/.dest")
    local check_dest="${DEST%/}"

    # Skip unsafe paths or high-traffic shared directories
    if ! is_safe_path "$DEST" || \
        [[ "$check_dest" == "$HOME/.config" ]] || \
        [[ "$check_dest" == "/etc" ]] || \
        [[ "$check_dest" == "/etc/systemd" ]] || \
        [[ "$check_dest" == "/etc/bluetooth" ]] || \
        [[ "$check_dest" == "/usr/lib/systemd/system-sleep" ]]; then
        return
    fi

    [[ ! -d "$DEST" ]] && return

    pushd "$DEST" > /dev/null
    while IFS= read -r -d '' file; do
        local rel_file="${file#./}"
        is_ignored "$rel_file" && continue

        if [[ ! -e "${DEV_ENV}/${m}/payload/${rel_file}" ]]; then
            log "${WARN}[AUDIT] [$module_name] Stale file found: $DEST/$rel_file${RESET}"
        fi
    done < <(find . -type f -print0)
    popd > /dev/null
}

if [[ -v XDG_CONFIG_HOME ]]; then
    echo "[RUN] XDG_CONFIG_HOME: $XDG_CONFIG_HOME"
else
    echo "[RUN] XDG_CONFIG_HOME not set. Defaulting to $HOME/.config"
    export XDG_CONFIG_HOME="${HOME}/.config"
fi

pushd "$DEV_ENV" > /dev/null

# Parse arguments
if [[ $1 == '-dry' || $1 == '--dry-run' || $1 == '-d' ]]; then
    export DRY_RUN='1'
fi
if [[ $1 == '--audit' || $1 == '-a' ]]; then
    export RUN_AUDIT='1'
fi

if [[ $RUN_AUDIT == '1' ]]; then
    log "${INFO}[RUN] Starting audit of configuration directories...${RESET}"
    for m in modules/*; do
        audit_module "$m"
    done
    log "${INFO}[RUN] Audit complete.${RESET}"
    exit 0
fi

# Iterate over directories in modules/
for m in modules/*; do
    if [[ ! -d "$m" ]]; then continue; fi

    module_name=$(basename "$m")

    # Skip if no .dest file
    if [[ ! -f "${m}/.dest" ]]; then
        log "${ERR}[RUN] $module_name: No .dest file found.${RESET}"
        continue
    fi

    if [[ ! -f "${m}/.check" ]]; then
        log "${ERR}[RUN] [$module_name] No .check script found.${RESET}"
    else
        if ! "${m}/.check"; then
            log "${ERR}[RUN] There has been an issue with the .check script of $module_name!${RESET}"
        fi
    fi

    # Check sudo requirement
    RUN_CMD=""
    if [[ -f "${m}/.sudo" ]]; then
        log "[RUN] $module_name requires sudo."
        sudo -v
        RUN_CMD="sudo"
    fi

    # Resolve Destination
    DEST=$(envsubst < "${m}/.dest")

    # --- The Logic Fix ---
    # Strategy: Use rsync to SYNC contents, not remove the directory.
    # Flags:
    # -a : Archive mode (recursive, preserves permissions/times/symlinks)
    # -v : Verbose
    # --mkpath : Create destination dir if it doesn't exist (requires rsync 3.2.3+)

    # Special Handling:
    # If DEST is HOME, we definitely just want to copy files INTO it (Merge).
    # If DEST is a config folder (e.g., ~/.config/alacritty), maybe we WANT to clean it?

    # Current Decision: STRICT MERGE everywhere.
    # If you want to delete old configs, use the --delete flag cautiously,
    # but NEVER use --delete if DEST is HOME.

    # RSYNC_FLAGS="-avu"
    RSYNC_FLAGS="-cau"

    # Safety Logic: If we are targeting a subfolder (like alacritty), we can
    # clean old files. If we are targeting HOME, we MUST NOT delete extraneous
    # files.
    if is_safe_path "$DEST"; then
       # It's safe to make the destination mirror the payload exactly (removes
       # stale config files)

       # Uncomment the next line if you WANT 'alacritty' to be wiped of unknown
       # files
       # RSYNC_FLAGS="-av --delete"
       :
    fi

    log "[RUN] $module_name -> $DEST"

    if [[ $DRY_RUN == "0" ]]; then
        # Ensure parent directory exists
        $RUN_CMD mkdir -p "$DEST"

        # RSYNC syntax note: Source must end in slash to copy CONTENTS
        $RUN_CMD rsync $RSYNC_FLAGS "${m}/payload/" "$DEST/"
    else
        if [[ -z $RUN_CMD ]]; then
            log "rsync $RSYNC_FLAGS ${m}/payload/ $DEST/"
        else
            log "$RUN_CMD rsync $RSYNC_FLAGS ${m}/payload/ $DEST/"
        fi
    fi
done

popd > /dev/null
