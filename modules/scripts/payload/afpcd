    local prog_name="${0##*/}"
    cat <<EOF
$prog_name - AnyFlip PDF Creator/Downloader
Usage: $prog_name [-v|--verbose]
                  [-D|-d|--debug]
                  [-h|--help]
                  [-l|--license]

Options:
  -[d|D] --debug    Runs the script in debug mode and shows the debug messages
  -v     --verbose  Shows extra info, runs all commands in verbose modes if applicable
  -h     --help     Shows this message
