#!/usr/bin/env bash

check_binaries() {
    if ! command -v waybar &> /dev/null; then
        log "${ERR}[RUN] [ERROR] waybar is not installed!${RESET}"
        exit 1
    fi
    
    if ! command -v playerctl &> /dev/null; then
        log "${WARN}[RUN] [WARNING] playerctl is missing. MPRIS/Media widgets will likely break.${RESET}"
    fi

    if ! command -v jq &> /dev/null; then
        log "${WARN}[RUN] [WARNING] jq is missing. Many JSON-based Waybar scripts rely on this.${RESET}"
    fi

    if ! fc-list | grep -qi -E "Nerd|Awesome"; then
        log "${WARN}[RUN] [WARNING] No Nerd Font or FontAwesome detected via fc-list. Waybar icons may be broken squares.${RESET}"
    fi
}

check_binaries "$@"

exit 0
