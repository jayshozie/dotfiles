# ----------------------- #
#  1. Idempotency Helper  #
# ----------------------- #
path_prepend() {
    if [ -d "$1" ] && [[ ":${PATH}:" != *":${1}:"* ]]; then
        export PATH="${1}:$PATH"
    fi
}

# --------------------------- #
#  2. XDG Base Specification  #
# --------------------------- #
# The rest are either already implemented on Arch by default, or simply not
# needed in my case.
export XDG_CONFIG_HOME="${HOME}/.config"
export XDG_DATA_HOME="${HOME}/.local/share"
export XDG_BIN_HOME="${HOME}/.local/bin"
export XDG_STATE_HOME="${HOME}/.local/state"
export XDG_CACHE_HOME="${HOME}/.cache"

# -------------------------- #
#  3. Environment Variables  #
# -------------------------- #
export DEV_ENV="${HOME}/dev"
export CLONES_DIR="${HOME}/src"
export MOZ_ENABLE_WAYLAND=1
export HYPRLAND_INSTANCE_SIGNATURE=$(ls -t /run/user/$(id -u)/hypr/ | head -n 1)
export RCLONE_PASSWORD_COMMAND="pass rclone"
# export DISPLAY=:1 # uncomment if needed

# Editors & Pagers
export EDITOR=nvim
export SYSTEMD_EDITOR=nvim
export VISUAL=nvim
export MANPAGER='nvim +Man!'
export CLONES_DIR=${HOME}/src
export GEMINI_SYSTEM_MD='~/.gemini/system.md'

# -------------------- #
#  4. Path Management  #
# -------------------- #
# NVM (Node Version Manager)
export NVM_DIR="${HOME}/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "${NVM_DIR}/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "${NVM_DIR}/bash_completion"

# Android SDK Tools
export ANDROID_HOME="${HOME}/.android-sdk"
path_prepend "${ANDROID_HOME}/cmdline-tools/latest/bin"

# Bun
export BUN_INSTALL="${HOME}/.bun"
path_prepend "${BUN_INSTALL}/bin"

# Ruby Gems
export GEM_HOME="${HOME}/gems"
path_prepend "${GEM_HOME}/bin"

# Cargo
path_prepend "${HOME}/.cargo/bin"

# Cabal
path_prepend "${HOME}/.cabal/bin"

# Local Scripts (Weather, Tmux, etc.)
path_prepend "${HOME}/.local/bin/scripts/weather"
path_prepend "${HOME}/.local/bin/scripts/tmux-sessionizer"
path_prepend "${HOME}/.local/bin/scripts"

# .local/bin
path_prepend "${HOME}/.local/bin"

# -------------- #
#  5. Linuxbrew  #
# -------------- #
if [[ ":${PATH}:" != *":/home/linuxbrew/.linuxbrew/bin:"* ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# ----------------------------------- #
#  6. Interactive Shell Integrations  #
# ----------------------------------- #
export STARSHIP_CONFIG="${XDG_CONFIG_HOME}/starship/starship.toml"
eval "$(starship init bash)"
